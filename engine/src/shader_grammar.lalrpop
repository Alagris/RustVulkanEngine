grammar;

use super::{
    CullMode, LexError, RenderQueue, ShaderDefinition, ShaderInputLayout, ShaderPassMetadata, Token,
};

pub Shader: ShaderDefinition = {
    "shader" <quoted_name: "quoted"> "{" <passes: Pass+> "}" => {
        let name = super::unquote(quoted_name);
        ShaderDefinition { name, passes }
    },
};

Pass: ShaderPassMetadata = {
    "pass" <quoted_name: "quoted"> "{" <face: Face> <queue: Queue> <hlsl: HlslBlock> "}" => {
        let name = super::unquote(quoted_name);
        ShaderPassMetadata {
            name,
            cull: face,
            queue,
            hlsl,
            vertex_inputs: ShaderInputLayout::default(),
            instance_inputs: ShaderInputLayout::default(),
        }
    },
};

Face: CullMode = {
    "face" <value: "quoted"> =>? crate::parsers::material_parser::parse_cull_mode(value)
        .map_err(|error| lalrpop_util::ParseError::User { error }),
};

Queue: RenderQueue = {
    "queue" <value: "quoted"> =>? crate::parsers::material_parser::parse_render_queue(value)
        .map_err(|error| lalrpop_util::ParseError::User { error }),
};

HlslBlock: String = {
    "hlsl" "{" <contents: HlslContents> "}" => contents,
};

HlslContents: String = {
    <items: HlslItem*> => items.concat(),
};

HlslItem: String = {
    <text: "text"> => text,
    <text: "identifier"> => text,
    <text: "quoted"> => text,
    "shader" => "shader".to_owned(),
    "pass" => "pass".to_owned(),
    "face" => "face".to_owned(),
    "queue" => "queue".to_owned(),
    "hlsl" => "hlsl".to_owned(),
    "{" <contents: HlslContents> "}" => format!("{{{}}}", contents),
};

extern {
    type Location = usize;
    type Error = LexError;

    enum Token {
        "shader" => Token::Shader,
        "pass" => Token::Pass,
        "face" => Token::Face,
        "queue" => Token::Queue,
        "hlsl" => Token::Hlsl,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "identifier" => Token::Identifier(<String>),
        "quoted" => Token::Quoted(<String>),
        "text" => Token::Text(<String>),
    }
}
